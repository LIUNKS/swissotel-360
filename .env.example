# Legacy Supabase / Monolith Reference (optional)
# SUPABASE_DB_URL=jdbc:postgresql://<YOUR_SUPABASE_HOST>:6543/postgres
# SUPABASE_DB_USERNAME=postgres.xxxxxxx
# SUPABASE_DB_PASSWORD=your_secure_password

# Local Docker Compose PostgreSQL 17 (Schema-per-Service)
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=5433
LOCAL_DB_NAME=swissotel360
LOCAL_DB_USER=swissotel
LOCAL_DB_PASSWORD=swissotel_dev_password

IAM_DB_URL=jdbc:postgresql://localhost:5433/swissotel360?currentSchema=iam,extensions
GUESTS_DB_URL=jdbc:postgresql://localhost:5433/swissotel360?currentSchema=guests,extensions
ROOMS_DB_URL=jdbc:postgresql://localhost:5433/swissotel360?currentSchema=rooms,extensions
RESERVATIONS_DB_URL=jdbc:postgresql://localhost:5433/swissotel360?currentSchema=reservations,extensions
OPERATIONS_DB_URL=jdbc:postgresql://localhost:5433/swissotel360?currentSchema=operations,extensions
BILLING_DB_URL=jdbc:postgresql://localhost:5433/swissotel360?currentSchema=billing,extensions

# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=swissotel
RABBITMQ_PASSWORD=swissotel_dev_password
RABBITMQ_ENABLED=true

# Microservices Ports & Internal URLs
GATEWAY_PORT=8080
IAM_SERVICE_PORT=8081
GUESTS_SERVICE_PORT=8082
ROOMS_SERVICE_PORT=8083
RESERVATIONS_SERVICE_PORT=8084
OPERATIONS_SERVICE_PORT=8085
BILLING_SERVICE_PORT=8086

IAM_SERVICE_URL=http://localhost:8081
GUESTS_SERVICE_URL=http://localhost:8082
ROOMS_SERVICE_URL=http://localhost:8083
RESERVATIONS_SERVICE_URL=http://localhost:8084
OPERATIONS_SERVICE_URL=http://localhost:8085
BILLING_SERVICE_URL=http://localhost:8086

# Security Configuration (JWT - minimum 32 characters for HS256)
JWT_SECRET=your_super_secure_example_jwt_secret_key

# OpenAPI Gateway URL & Production Overrides
OPENAPI_SERVER_URL=http://localhost:8080
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=Lax
# CORS_ALLOWED_ORIGINS=https://app.example.com
# JPA_SHOW_SQL=false
